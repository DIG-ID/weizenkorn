                "sub_fields": [
                    {
                        "key": "field_sch_offer_section_title",
                        "label": "Section Title",
                        "name": "section_title",
                        "type": "clone",
                        "clone": [
                            "group_6a4fb434d42e9"
                        ],
                        "display": "group",
                        "layout": "block",
                        "prefix_label": 0,
                        "prefix_name": 0
                    },
                    {
                        "key": "field_sch_offer_items",
