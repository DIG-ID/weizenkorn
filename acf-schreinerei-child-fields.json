                                "required": 1,
                                "return_format": "id",
                                "preview_size": "medium",
                                "library": "all"
                            },
                            {
                                "key": "field_sch_offer_title",
                                "label": "Title",
                                "name": "title",
                                "type": "text",
                                "instructions": "The name on the cream bar."
                            },
                            {
                                "key": "field_sch_offer_text",
                                "label": "Text",
                                "name": "text",
                                "type": "textarea",
                                "instructions": "Revealed on hover at desktop, and on a tap below it.",
                                "new_lines": "wpautop",
                                "rows": 3
                            },
                            {
                                "key": "field_sch_offer_link",
                                "label": "Link",
                                "name": "link",
                                "type": "link",
                                "instructions": "Optional. The card then shows \"mehr erfahren\" — type a Title on the link to say something else instead.",
                                "return_format": "array"
                            }
                        ]
                    }
                ]
            },
            {
                "key": "field_sch_text_columns",
                "label": "Text Columns",
                "name": "text_columns",
